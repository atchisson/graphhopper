# Copy to .env (gitignored) and fill in. Read automatically by docker-compose.

# ---- Server-side Matomo analytics (see docs/web/analytics.md) ----
MATOMO_ENABLED=false

# Tracking endpoint of your Matomo instance
MATOMO_URL=https://analytics.example.com/matomo.php
MATOMO_SITE_ID=1

# Mandatory. Administration > Personal > Security > Auth tokens.
# Without it Matomo ignores the visitor IP and user agent, and every visit is attributed to this server.
MATOMO_TOKEN_AUTH=

# Base URL used to build the page URLs reported to Matomo
MATOMO_SITE_URL=https://maps.example.com

# Any random string. Keeps the pseudonymous visitor ids stable across restarts.
MATOMO_VISITOR_ID_SALT=

# Set to true when running behind a reverse proxy, otherwise every visitor looks like the proxy
MATOMO_TRUST_FORWARDED_FOR=true

# Report only a fraction of the API events on a busy instance (1.0 = all). Page views are never sampled.
MATOMO_API_SAMPLE_RATE=1.0
